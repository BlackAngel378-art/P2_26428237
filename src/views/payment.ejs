<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registro de Pago</title>
  <link rel="stylesheet" href="/css/payment.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <script src='/js/alertConfig.js'></script>
</head>
<body>
     <!-- Header -->
<header class="fixed top-0 left-0 w-full py-4 px-6 lg:px-16 z-10 transition-all duration-300 bg-white shadow-sm">
    <div class="flex justify-between items-center max-w-7xl mx-auto">
        <div class="flex items-center">
            <a href="#" class="text-2xl font-bold">
                <span class="gradient-text">Finex</span>
            </a>
        </div>
        
        <nav class="hidden md:block">
            <ul class="flex space-x-8">
                <li><a href="#servicios" class="font-medium hover:text-blue-600 transition-colors">Servicios</a></li>
                <li><a href="#beneficios" class="font-medium hover:text-blue-600 transition-colors">Beneficios</a></li>
                <li><a href="/getPayment" class="font-medium hover:text-blue-600 transition-colors">Pagos</a></li>
                <li><a href="/admin/contacts" class="font-medium hover:text-blue-600 transition-colors">Contacto</a></li>
                <li><a href="/login" class="font-medium hover:text-blue-600 transition-colors">Login</a></li>
            </ul>
        </nav>
        
        <div class="flex items-center space-x-4">
            <a href="tel:+34987654321" class="hidden md:flex items-center text-blue-600 font-semibold">
                <i class="fas fa-phone mr-2"></i>
                <span>+58 424 3796067</span>
            </a>
            <a href="#contacto" class="gradient-bg text-white px-6 py-2 rounded-full font-semibold hover:shadow-lg transition-all">
                <i class="fas fa-bolt mr-2"></i> Urgencias
            </a>
            <button id="mobile-menu-button" class="md:hidden text-2xl focus:outline-none">
                <i class="fas fa-bars" id="menu-icon"></i>
            </button>
        </div>
    </div>

    <!-- Menú móvil -->
    <div id="mobile-menu" class="md:hidden hidden bg-white w-full absolute left-0 top-full shadow-lg">
        <ul class="py-4 px-6 space-y-4">
            <li><a href="#servicios" class="block font-medium hover:text-blue-600 transition-colors py-2">Servicios</a></li>
            <li><a href="#beneficios" class="block font-medium hover:text-blue-600 transition-colors py-2">Beneficios</a></li>
            <li><a href="/getPayment" class="block font-medium hover:text-blue-600 transition-colors py-2">Pagos</a></li>
             <li><a href="/login" class="font-medium hover:text-blue-600 transition-colors">Login</a></li>
            <li><a href="/admin/contacts" class="block font-medium hover:text-blue-600 transition-colors py-2">Contacto</a></li>
            <li class="pt-4 border-t border-gray-200">
                <a href="tel:+584243796067" class="flex items-center text-blue-600 font-semibold">
                    <i class="fas fa-phone mr-2"></i>
                    <span>+58 424 3796067</span>
                </a>
            </li>
        </ul>
    </div>
</header>
  <div class="payment-container">
    <div class="payment-header">
      <h1 class="payment-title">Registro de Pago <i class="fas fa-credit-card card-icon"></i></h1>
      <p class="payment-subtitle">Complete los detalles de su tarjeta</p>
    </div>
    
    <form id='formularioPayment' class="payment-form">
      <div class="form-group">
        <label for="email" class="form-label">Correo Electrónico</label>
        <input type="email" id="correo" name="correo" class="form-input" placeholder="ejemplo@dominio.com" required>
      </div>
      
      <div class="form-group">
        <label for="cardholder" class="form-label">Nombre del Titular</label>
        <input type="text" id="nombreTitular" name="nombreTitular" class="form-input" placeholder="Como aparece en la tarjeta" required>
      </div>
      
      <div class="form-group">
          <label for="cardNumber" class="form-label">Número de Tarjeta</label>
          
          <select name="cardNumber" id="cardNumber" class="form-input" required>
            <option value="0">Seleccione un numero de cuenta</option>
            <option value="5555555555554444">5555555555554444</option>
            <option value="4111111111111111">4111111111111111</option>
            <option value="3530111333300000">3530111333300000</option>
            <option value="378282246310005">378282246310005</option>
            <option value="6011111111111117">6011111111111117</option>
            <option value="30569309025904">30569309025904</option>
          </select>
        </div>

        <div class="form-group">
          <label for="descripcion" class="form-label">Descripcion</label>
          <input type="text" id="descripcion" name="descripcion" class="form-input" placeholder="Ingresa Descripcion" required>
        </div>
      
      <div class="card-details">
        <div class="form-group">
          <label class="form-label">Fecha de Expiración</label>
          <div class="expiration-group">
            <select id="expMonth" name="expMonth" class="form-input expiration-input" required>
              <option value="" disabled selected>Mes</option>
              <% for(let i = 1; i <= 12; i++) { %>
                <option value="<%= i < 10 ? '0' + i : i %>"><%= i < 10 ? '0' + i : i %></option>
              <% } %>
            </select>
            <select id="expYear" name="expYear" class="form-input expiration-input" required>
              <option value="" disabled selected>Año</option>
              <% const currentYear = new Date().getFullYear(); %>
              <% for(let i = 0; i < 10; i++) { %>
                <option value="<%= currentYear + i %>"><%= currentYear + i %></option>
              <% } %>
            </select>
          </div>
        </div>
        
        <div class="form-group">
          <label for="cvv" class="form-label">Código de Seguridad</label>
          <input type="text" id="cvv" name="cvv" class="form-input" placeholder="123" pattern="[0-9]{3,4}" required>
        </div>
      </div>
      
      <div class="form-group">
        <label class="form-label">Monto a Pagar</label>
        <div class="amount-group">
          <select id="currency" name="currency" class="form-input currency-select" required>
            <option value="USD">USD $</option>
            <option value="EUR">EUR €</option>
            <option value="GBP">GBP £</option>
            <option value="JPY">JPY ¥</option>
          </select>
          <input type="number" id="amount" name="amount" class="form-input" placeholder="0.00" min="0" step="0.01" required>
        </div>
      </div>
      
      <button type="submit" class="submit-btn">
        <i class="fas fa-lock"></i> Realizar Pago
      </button>
    </form>
  </div>
  <script src='/js/fetch2.js'></script>
</body>
</html>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registros de Pagos</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#3498db',
                        secondary: '#2c3e50',
                        success: '#27ae60',
                        warning: '#f39c12',
                        danger: '#e74c3c',
                    },
                    fontFamily: {
                        roboto: ['Roboto', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        .card-number {
            font-family: 'Courier New', monospace;
            letter-spacing: 1px;
        }
    </style>
</head>
<body class="bg-gray-50 font-roboto">
    <!-- 🔽 NAVBAR -->
<nav class="bg-white border-b border-gray-200 px-4 py-3 md:flex md:items-center md:justify-between">
  <div class="flex justify-between items-center">
    <a href="/" class="text-xl font-bold text-blue-600">TuLogo</a>

    <!-- Botón hamburguesa -->
    <button id="menu-toggle" class="md:hidden text-gray-700 focus:outline-none">
      <svg id="open-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" stroke-width="2"
           viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="2"
           viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Menú desplegable -->
  <ul id="menu" class="hidden mt-3 md:mt-0 md:flex space-y-2 md:space-y-0 md:space-x-6">
    <li><a href="#servicios" class="block font-medium hover:text-blue-600 transition-colors">Servicios</a></li>
    <li><a href="#beneficios" class="block font-medium hover:text-blue-600 transition-colors">Beneficios</a></li>
    <li><a href="/getPayment" class="block font-medium hover:text-blue-600 transition-colors">Pagos</a></li>
    <li><a href="/login" class="block font-medium hover:text-blue-600 transition-colors">Login</a></li>
    <li><a href="/admin/contacts" class="block font-medium hover:text-blue-600 transition-colors">Contacto</a></li>
    <li><a href="/login?form=login" class="block font-medium hover:text-blue-600 transition-colors"><i class="fa fa-sign-in"></i> Login</a></li>
    <% if (isAdmin) { %>
    <li><a href="/logout" class="block font-medium hover:text-blue-600 transition-colors"><i class="fas fa-sign-out-alt"></i> Cerrar</a></li>
    <% } %>
  </ul>
</nav>
    <div class="container mx-auto px-4 py-8">
        <!-- Filtros -->
        <form id="filterForm" class="mb-8 bg-white p-6 rounded-lg shadow-sm">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="md:col-span-2">
                    <label for="searchInput" class="block text-sm font-medium text-gray-700 mb-1">Buscar</label>
                    <input id="searchInput" type="text" placeholder="Nombre o correo" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
                </div>
                
                <div>
                    <label for="estadoSelect" class="block text-sm font-medium text-gray-700 mb-1">Estado</label>
                    <select id="estadoSelect" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
                        <option value="">Todos</option>
                        <option value="aprobado">Aprobado</option>
                        <option value="rechazado">Rechazado</option>
                        <option value="pendiente">Pendiente</option>
                    </select>
                </div>
                
                <div>
                    <label for="servicioSelect" class="block text-sm font-medium text-gray-700 mb-1">Servicio</label>
                    <select id="servicioSelect" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
                        <option value="">Todos</option>
                        <option value="Suscripción Mensual">Suscripción Mensual</option>
                        <option value="Suscripción Anual">Suscripción Anual</option>
                    </select>
                </div>
                
                <div>
                    <label for="fechaInicio" class="block text-sm font-medium text-gray-700 mb-1">Desde</label>
                    <input type="date" id="fechaInicio" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
                </div>
                
                <div>
                    <label for="fechaFin" class="block text-sm font-medium text-gray-700 mb-1">Hasta</label>
                    <input type="date" id="fechaFin" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
                </div>
            </div>
        </form>

        <!-- Contenedor principal -->
        <div id="contactsContainer" class="bg-white rounded-lg shadow-sm overflow-hidden">
            <div class="p-6 border-b border-gray-200">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <h1 class="text-2xl font-semibold text-secondary flex items-center gap-2">
                        <i class="fas fa-credit-card text-primary"></i>
                        Registros de Pagos
                    </h1>
                    <span class="bg-primary text-white px-3 py-1 rounded-full text-sm">
                        Total: <%=datePayments.length%>
                    </span>
                </div>
            </div>

            <% if (datePayments.length > 0) { %>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Titular</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Correo</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tarjeta</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Expiración</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Moneda</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <% datePayments.forEach(payment => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= payment.nombreTitular %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= payment.correo %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <div class="flex items-center gap-2">
                                        <span class="card-number">•••• •••• •••• <%= payment.cardNumber.slice(-4) %></span>
                                        <% if (['4'].includes(payment.cardNumber.charAt(0))) { %>
                                            <i class="fab fa-cc-visa text-blue-600"></i>
                                        <% } else if (['5'].includes(payment.cardNumber.charAt(0))) { %>
                                            <i class="fab fa-cc-mastercard text-red-600"></i>
                                        <% } else if (['3'].includes(payment.cardNumber.charAt(0))) { %>
                                            <i class="fab fa-cc-amex text-blue-400"></i>
                                        <% } else { %>
                                            <i class="fas fa-credit-card text-gray-400"></i>
                                        <% } %>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= payment.expMonth %>/<%= payment.expYear.toString().slice(-2) %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                    <% if (payment.currency === 'USD') { %>
                                        <span class="text-success">$<%= payment.amount %> USD</span>
                                    <% } else if (payment.currency === 'EUR') { %>
                                        <span class="text-success">€<%= payment.amount %> EUR</span>
                                    <% } else if (payment.currency === 'GBP') { %>
                                        <span class="text-success">£<%= payment.amount %> GBP</span>
                                    <% } else { %>
                                        <span class="text-success"><%= payment.amount %> <%= payment.currency %></span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <div class="flex flex-col">
                                        <span><%= new Date(payment.createdAt).toLocaleDateString() %></span>
                                        <span class="text-gray-400 text-xs"><%= new Date(payment.createdAt).toLocaleTimeString() %></span>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="p-8 text-center">
                    <i class="fas fa-credit-card text-4xl text-gray-300 mb-4"></i>
                    <p class="text-gray-500">No hay registros de pagos disponibles</p>
                </div>
            <% } %>
        </div>
    </div>
    <script src='/js/desplegable.js'></script>
    <script src='/js/filterPayment.js'></script>
</body>
</html>
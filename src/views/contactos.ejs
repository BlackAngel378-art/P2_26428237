<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registros de Contactos</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/table.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
</head>
<body>
       <!-- 🔽 NAVBAR -->
<nav class="bg-white border-b border-gray-200 px-4 py-3 md:flex md:items-center md:justify-between">
  <div class="flex justify-between items-center">
    <a href="/" class="text-xl font-bold text-blue-600">TuLogo</a>

    <!-- Botón hamburguesa -->
    <button id="menu-toggle" class="md:hidden text-gray-700 focus:outline-none">
      <svg id="open-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" stroke-width="2"
           viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="2"
           viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Menú desplegable -->
  <ul id="menu" class="hidden mt-3 md:mt-0 md:flex space-y-2 md:space-y-0 md:space-x-6">
    <li><a href="#servicios" class="block font-medium hover:text-blue-600 transition-colors">Servicios</a></li>
    <li><a href="#beneficios" class="block font-medium hover:text-blue-600 transition-colors">Beneficios</a></li>
    <li><a href="/getPayment" class="block font-medium hover:text-blue-600 transition-colors">Pagos</a></li>
    <li><a href="/login" class="block font-medium hover:text-blue-600 transition-colors">Login</a></li>
    <li><a href="/admin/contacts" class="block font-medium hover:text-blue-600 transition-colors">Contacto</a></li>
    <li><a href="/login?form=login" class="block font-medium hover:text-blue-600 transition-colors"><i class="fa fa-sign-in"></i> Login</a></li>
    <% if (isAdmin) { %>
    <li><a href="/logout" class="block font-medium hover:text-blue-600 transition-colors"><i class="fas fa-sign-out-alt"></i> Cerrar</a></li>
    <% } %>
  </ul>
</nav>
    <div class="contacts-container">
        <div class="contacts-header">
            <h1 class="contacts-title">Registros de Contacto</h1>
            <span>Total: <%= contacts.length %></span>
        </div>
        <form id="filterForm" class="mb-6 w-full max-w-lg mx-auto">
          <div class="relative">
            <input
            type="text"
            id="searchInput"
            placeholder="Buscar por nombre o correo..."
            class="w-full px-4 py-3 pr-10 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 placeholder-gray-400 text-gray-700"
            />
            <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
              <i class="fas fa-search text-gray-400"></i>
          </div>
      </div>
  </form>

  <!-- Contenedor dinámico de contactos -->
  <div id="contactsContainer">
        <% if (contacts.length > 0) { %>
            <table class="contacts-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Comentario</th>
                        <th>IP</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    <% contacts.forEach(contact => { %>
                        <tr>
                            <td data-label="Nombre"><%= contact.nombre %></td>
                            <td data-label="Email" class="contact-email"><%= contact.email %></td>
                            <td data-label="Comentario"><%= contact.comentario %></td>
                            <td data-label="IP" class="contact-ip"><%= contact.ip %></td>
                            <td data-label="Fecha" class="contact-date">
                                <%= new Date(contact.createdAt).toLocaleDateString() %>
                                <br>
                                <%= new Date(contact.createdAt).toLocaleTimeString() %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } else { %>
            <p>No hay registros de contactos disponibles.</p>
        <% } %>
    </div>
    <script src='/js/desplegable.js'></script>
    <script src='/js/filter.js'></script>
</body>
</html>
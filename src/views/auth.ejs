<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/styles.css">
  <title>Autenticación</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="js/alertConfig.js"></script>
  <style>
    .google-btn {
      display: inline-flex;
      align-items: center;
      padding: 10px 15px;
      background: white;
      color: #444;
      border: 1px solid #ddd;
      border-radius: 4px;
      text-decoration: none;
    }
    .google-btn img {
      width: 20px;
      margin-right: 10px;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-blue-100 to-blue-300 min-h-screen flex items-center justify-center px-4 flex-col">
  <div class="w-full max-w-md bg-white shadow-xl rounded-lg p-6">

    <div class="flex justify-center mb-6">
      <button 
      onclick="switchForm('login')" 
      class="w-1/2 py-2 text-center text-sm font-semibold border-b-2 transition duration-300 
      <%= formType === 'login' ? 'border-blue-600 text-blue-600' : 'border-transparent text-gray-500 hover:text-blue-500' %>">
      Iniciar Sesión
    </button>
    <button 
    onclick="switchForm('register')" 
    class="w-1/2 py-2 text-center text-sm font-semibold border-b-2 transition duration-300 
    <%= formType === 'register' ? 'border-blue-600 text-blue-600' : 'border-transparent text-gray-500 hover:text-blue-500' %>">
    Registrarse
  </button>
</div>

<% if (formType === 'login'){ %>
<form id="formLogin" class="space-y-4">
  <h2 class="text-2xl font-bold text-blue-700 text-center">Iniciar Sesión</h2>

  <div>
    <label for="login-email" class="block text-sm font-medium text-gray-700">Correo Electrónico</label>
    <input type="email" id="login-email" name="email" required placeholder="tucorreo@ejemplo.com"
    class="w-full px-4 py-2 mt-1 border rounded focus:outline-none focus:ring-2 focus:ring-blue-400">
  </div>

  <div>
    <label for="login-password" class="block text-sm font-medium text-gray-700">Contraseña</label>
    <input type="password" id="login-password" name="password" required placeholder="••••••••"
    class="w-full px-4 py-2 mt-1 border rounded focus:outline-none focus:ring-2 focus:ring-blue-400">
  </div>

  <a href="/auth/google" class="flex items-center justify-center gap-2 w-full bg-red-500 text-white py-2 rounded hover:bg-red-600 transition">
    <i class="fab fa-google"></i> Iniciar sesión con Google
  </a>
  <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700 transition">
    Ingresar
  </button>
</form>

<% } else { %>
<form id="formRegister" class="space-y-4">
  <h2 class="text-2xl font-bold text-blue-700 text-center">Crear Cuenta</h2>
  <div>
    <label for="username" class="block text-sm font-medium text-gray-700">Nombre Completo</label>
    <input type="text" id="username" name="username" required placeholder="Juan Pérez"
    class="w-full px-4 py-2 mt-1 border rounded focus:outline-none focus:ring-2 focus:ring-blue-400">
  </div>
  <div>
    <label for="register-email" class="block text-sm font-medium text-gray-700">Correo Electrónico</label>
    <input type="email" id="register-email" name="email" required placeholder="tucorreo@ejemplo.com"
    class="w-full px-4 py-2 mt-1 border rounded focus:outline-none focus:ring-2 focus:ring-blue-400">
  </div>
  <div>
    <label for="register-password" class="block text-sm font-medium text-gray-700">Contraseña</label>
    <input type="password" id="register-password" name="password_hash" required placeholder="••••••••" minlength="6"
    class="w-full px-4 py-2 mt-1 border rounded focus:outline-none focus:ring-2 focus:ring-blue-400">
  </div>
  <div>
    <label for="register-confirm" class="block text-sm font-medium text-gray-700">Confirmar Contraseña</label>
    <input type="password" id="register-confirm" name="passwordHash" required placeholder="••••••••"
    class="w-full px-4 py-2 mt-1 border rounded focus:outline-none focus:ring-2 focus:ring-blue-400">
  </div>

  <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700 transition">
    Registrarse
  </button>
</form>
<% } %>
</div>
<script>
  function switchForm(type) {
    window.location.href = `/login?form=${type}`;
  }
</script>
<script>
  let data,formData
  const formRegister = document.querySelector('#formRegister');
  if (formRegister) {
    formRegister.addEventListener('submit', e => {
      e.preventDefault();
      formData = new FormData(e.target);
      data = Object.fromEntries(formData.entries());
      fetch('/registerUser', {
        method: 'POST',
        headers: {
          "Content-type": "application/json"
        },
        body: JSON.stringify(data)
      })
      .then(res => res.json())
      .then(res => {
        Swal.fire(res.message);
      });
    });
  }
</script>
<script>
  const formLogin = document.querySelector('#formLogin');
  if (formLogin) {
    formLogin.addEventListener('submit', e => {
      e.preventDefault();
      formData = new FormData(e.target);
      data = Object.fromEntries(formData.entries());
      fetch('/loginPost', {
        method: 'POST',
        headers: {
          "Content-type": "application/json"
        },
        body: JSON.stringify(data)
      })
      .then(res => res.json())
      .then(res => {
        if (res.status) {
          Swal.fire(res.message).then(() => {
            window.location.href = '/admin/contacts';
          });
        } else {
          Swal.fire(res.message);
        }
      });
    });
  }
</script>
</body>

</html>